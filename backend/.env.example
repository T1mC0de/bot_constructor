# Copy to .env and fill in: cp .env.example .env
# `make run` loads .env automatically. Write values without quotes.

# --- core ---
# Address of the core HTTP API.
HTTP_ADDR=localhost:8080
# Where the survey and the orders are stored.
SURVEY_FILE=data/survey.json
ORDERS_FILE=data/orders.json

# --- bot ---
# Telegram bot token from @BotFather (required).
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-token
# Where the bot finds the core API.
CORE_URL=http://localhost:8080
